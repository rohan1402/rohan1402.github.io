# Ask Rohan environment variables.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Phase 1 (scripted parity port) needs NONE of these: the site runs fully in
# scripted mode with no keys. They are used from Phase 2 onward.

# --- Anthropic (Phase 2: real AI chat) ---
# Required for live model responses. Without it, the app serves the scripted engine.
ANTHROPIC_API_KEY=

# --- Upstash Redis (Phase 3: rate limiting) ---
# Required in production to enforce the global daily cap. If absent in production,
# the route fails closed to the scripted engine. In local dev, absence is fine.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GoatCounter analytics (optional) ---
# The GoatCounter site code, e.g. "askrohan" for https://askrohan.goatcounter.com.
# If unset, analytics is a no-op (no script loaded, no events sent).
NEXT_PUBLIC_GOATCOUNTER_CODE=
